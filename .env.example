# Copy this file to .env for local reference only — cloud hosts (Render,
# Railway, etc.) want these set directly in their dashboard as environment
# variables, not from a committed .env file. This file is just here to
# document what's needed; it holds no real secrets.

# Required in production (cloud deployment). Paste the ENTIRE contents of
# your Firebase service account key JSON file as the value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Required in production. Any long random string — used to sign login session
# cookies. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional — most hosts set this automatically.
PORT=3000

# Set to "production" when deployed to a cloud host (enables secure cookies).
# Leave unset for local/office use.
NODE_ENV=
